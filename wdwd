def update_course_scroll(event=None):

    course_canvas.configure(
        scrollregion=course_canvas.bbox("all")
    )


def resize_course_frame(event):

    course_canvas.itemconfigure(
        course_window,
        width=event.width
    )


course_list_frame.bind(
    "<Configure>",
    update_course_scroll
)

course_canvas.bind(
    "<Configure>",
    resize_course_frame
)

