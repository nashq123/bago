def suggest_course():

    characteristics = (
        characteristics_entry.get()
        .lower()
        .strip()
    )

    skills = (
        skills_entry.get()
        .lower()
        .strip()
    )

    interests = (
        interests_entry.get()
        .lower()
        .strip()
    )

    combined = (
        characteristics + " " +
        skills + " " +
        interests
    )

    if not combined.strip():

        messagebox.showwarning(
            "Missing Information",
            "Please enter your characteristics, skills, or interests."
        )

        return

    keywords = [
        word
        for word in combined.replace(",", " ").split()
        if len(word) >= 2
    ]

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        SELECT course_code, course_name, skills, features
        FROM courses
        ORDER BY id
    """)

    courses = cur.fetchall()

    conn.close()

    results = []

    for code, name, course_skills, features in courses:

        searchable = (
            code + " " +
            name + " " +
            course_skills + " " +
            features
        ).lower()

        score = 0

        for keyword in keywords:

            if keyword in searchable:

                score += 1

        if score > 0:

            results.append(
                (
                    score,
                    code,
                    name,
                    features
                )
            )

    results.sort(
        reverse=True,
        key=lambda x: x[0]
    )

    result_courses = []

    for score, code, name, features in results:

        result_courses.append(
            (
                code,
                name,
                features
            )
        )

    display_courses(
        result_courses,
        f"RECOMMENDED PROGRAMS  •  {len(result_courses)} MATCHES"
    )


