def draw_rounded_rect(canvas, x1, y1, x2, y2, radius=15, **kwargs):
  """Helper para sa mga rounded corner shapes."""
  points = [
      x1 + radius,
      y1,
      x1 + radius,
      y1,
      x2 - radius,
      y1,
      x2 - radius,
      y1,
      x2,
      y1,
      x2,
      y1 + radius,
      x2,
      y1 + radius,
      x2,
      y2 - radius,
      x2,
      y2 - radius,
      x2,
      y2,
      x2 - radius,
      y2,
      x2 - radius,
      y2,
      x1 + radius,
      y2,
      x1 + radius,
      y2,
      x1,
      y2,
      x1,
      y2 - radius,
      x1,
      y2 - radius,
      x1,
      y1 + radius,
      x1,
      y1 + radius,
      x1,
      y1,
  ]
  return canvas.create_polygon(points, **kwargs, smooth=True)


class CustomButton(tk.Canvas):
  """Custom rounded button na may hover effect."""

  def __init__(
      self,
      parent,
      text,
      command=None,
      width=220,
      height=42,
      radius=12,
      bg_color="#059669",
      hover_color="#047857",
      text_color="white",
      font=("Segoe UI", 10, "bold"),
  ):
    super().__init__(
        parent,
        width=width,
        height=height,
        bg=parent["bg"],
        highlightthickness=0,
    )
    self.command = command
    self.bg_color = bg_color
    self.hover_color = hover_color

    self.rect = draw_rounded_rect(
        self,
        2,
        2,
        width - 2,
        height - 2,
        radius=radius,
        fill=self.bg_color,
        outline="",
    )
    self.text_draw = self.create_text(
        width / 2, height / 2, text=text, fill=text_color, font=font
    )

    self.bind("<Enter>", lambda e: self.itemconfig(self.rect, fill=hover_color))
    self.bind("<Leave>", lambda e: self.itemconfig(self.rect, fill=bg_color))
    self.bind("<Button-1>", lambda e: self.command() if self.command else None)
    self.config(cursor="hand2")


