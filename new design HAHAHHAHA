def suggest_course():
  name = entry_name.get().strip()
  chars_input = entry_chars.get().lower().strip()
  skills_input = entry_skills.get().lower().strip()
  interest_input = entry_interest.get().lower().strip()

  if chars_input.startswith("ex:"):
    chars_input = ""
  if skills_input.startswith("ex:"):
    skills_input = ""
  if interest_input.startswith("ex:"):
    interest_input = ""

  for widget in course_list_frame.winfo_children():
    widget.destroy()

  combined_input = f"{chars_input} {skills_input} {interest_input}".strip()

  if not combined_input:
    reason_label.config(
        text="Type   any in Characteristics, Skills, and"
        " Interest.",
        fg="#EF4444",
    )
    return

  conn = get_connection()
  cur = conn.cursor()
  cur.execute("SELECT course_code, course_name, skills, features FROM courses")
  all_courses = cur.fetchall()
  conn.close()

  user_keywords = [
      k.strip()
      for k in combined_input.replace(",", "|").split("|")
      if len(k.strip()) >= 2
  ]
  words = combined_input.replace(",", " ").split()
  user_keywords.extend([w.strip() for w in words if len(w.strip()) >= 3])
  user_keywords = list(set(user_keywords))

  matched = []
  for course in all_courses:
    code, c_name, skills_str, features = course
    db_keywords = [k.strip() for k in skills_str.lower().split(",")]

    score = sum(
        1
        for u in user_keywords
        for c in db_keywords
        if u == c or u in c.split() or c in u.split()
    )
    if score > 0:
      matched.append((code, c_name, score, features))

  disp_name = f"Hi {name}!" if name and not name.startswith("Ex:") else "Hi!"

  if not matched:
    reason_label.config(
        text=(
            f"{disp_name} No match. Try:"
            " coding, business, travel, o teaching."
        ),
        fg="#EF4444",
    )
  else:
    matched_sorted = sorted(matched, key=lambda x: x[2], reverse=True)
    reason_label.config(
        text=(
            f"Hi! {disp_name} Suggested course that fits you!"
            "(Click to view):"
        ),
        fg="#059669",
    )

    for code, c_name, score, c_features in matched_sorted:
      card_btn = tk.Frame(
          course_list_frame,
          bg="#F1F5F9",
          padx=12,
          pady=10,
          cursor="hand2",
          highlightthickness=1,
          highlightbackground="#CBD5E1",
      )
      card_btn.pack(fill="x", pady=5, padx=5)

      lbl_code = tk.Label(
          card_btn,
          text=f"🎓 {code}",
          font=("Segoe UI", 11, "bold"),
          bg="#F1F5F9",
          fg="#059669",
          anchor="w",
      )
      lbl_code.pack(fill="x")

      lbl_title = tk.Label(
          card_btn,
          text=c_name,
          font=("Segoe UI", 9),
          bg="#F1F5F9",
          fg="#334155",
          anchor="w",
      )
      lbl_title.pack(fill="x")

      def bind_click(f, c=code, n=c_name, feat=c_features):
        f.bind("<Button-1>", lambda e: show_course_details(c, n, feat))
        for child in f.winfo_children():
          child.bind("<Button-1>", lambda e: show_course_details(c, n, feat))

      bind_click(card_btn)


