def suggest_course():
  name = entry_name.get().strip()
  chars_input = entry_chars.get().lower().strip()
  skills_input = entry_skills.get().lower().strip()
  interest_input = entry_interest.get().lower().strip()

  for widget in course_list_frame.winfo_children():
    widget.destroy()

  result_outer.pack(fill="x", pady=(15, 0), anchor="center")

  if "ex:" in chars_input:
    chars_input = ""
  if "ex:" in skills_input:
    skills_input = ""
  if "ex:" in interest_input:
    interest_input = ""

  combined_input = f"{chars_input} {skills_input} {interest_input}".strip()

  if not combined_input:
    reason_label.config(
        text=(
            "Please fill up at least one field (Characteristics, Skills, or"
            " Interest)"
        ),
        fg="#E74C3C",
    )
    return

  conn = get_connection()
  cur = conn.cursor()
  cur.execute("SELECT course_code, course_name, skills, features FROM courses")
  all_courses = cur.fetchall()
  conn.close()

  user_keywords = [
      k.strip()
      for k in combined_input.replace(",", "|").split("|")
      if len(k.strip()) >= 2
  ]
  words = combined_input.replace(",", " ").split()
  user_keywords.extend([w.strip() for w in words if len(w.strip()) >= 3])
  user_keywords = list(set(user_keywords))

  matched = []
  for course in all_courses:
    course_code, course_name, course_skills_str, course_features = (
        course[0],
        course[1],
        course[2],
        course[3],
    )
    course_db_keywords = [
        k.strip() for k in course_skills_str.lower().split(",")
    ]

    score = 0
    for u in user_keywords:
      for c in course_db_keywords:
        if u == c or u in c.split() or c in u.split():
          score += 1
          break
    if score > 0:
      matched.append((course_code, course_name, score, course_features))

  if not matched:
    reason_label.config(
        text=(
            f"Hi {name}, No match found. Try: masipag,"
            " coding, business, pagluluto, travel"
        ),
        fg="#E74C3C",
    )
  else:
    matched_sorted = sorted(matched, key=lambda x: x[2], reverse=True)
    reason_label.config(
        text=f"Hi {name}! Click any course below to view its FEATURES:",
        fg="#026307",
    )

    for code, c_name, score, c_features in matched_sorted:
      btn_text = f"{code} - {c_name}"
      c_btn = tk.Button(
          course_list_frame,
          text=btn_text,
          font=("Arial", 10, "bold"),
          fg="#FB0808",
          bg="white",
          activeforeground="#026307",
          activebackground="#DCFCE7",
          bd=0,
          cursor="hand2",
          command=lambda c=code, n=c_name, f=c_features: show_course_details(
              c, n, f
          ),
      )
      c_btn.pack(pady=2, fill="x")

  canvas.yview_moveto(0)

