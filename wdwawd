    if code in {"BSEE", "BSArch", "BSCE", "BSCpE", "BSECE"}:
        return "#C62828"  # CEA - Red
    if code in {"BSN", "BSML", "BSPT", "BSPhar"}:
        return "#2E7D32"  # CAHS - Green
    if code == "BSPsych":
        return "#8E24AA"  # CAHS - Purple
    if code in {"BSED", "AB PolSci", "AB Comm"}:
        return "#1565C0"  # CELA - Blue
    if code == "BSCRIM":
        return "#455A64"
    return PHINMA_GREEN


