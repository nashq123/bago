        pady=(5, 0)
    )

    children = [
        card,
        body,
        code_label,
        name_label,
        tuition_label,
        view_label
    ]

    def open_course(event=None):

        show_course_details(
            code,
            name,
            features
        )

    def hover_on(event=None):

        card.config(
            bg=PHINMA_LIGHT,
            highlightbackground=course_color
        )

        body.config(
            bg=PHINMA_LIGHT
        )

        for child in [
            code_label,
            name_label,
            tuition_label,
            view_label
