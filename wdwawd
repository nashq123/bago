    0,
    weight=1
)

course_outer.grid_columnconfigure(
    0,
    weight=1
)

course_canvas = tk.Canvas(
    course_outer,
    bg=BG,
    highlightthickness=0
)

course_scrollbar = tk.Scrollbar(
    course_outer,
    orient="vertical",
    command=course_canvas.yview
)

course_list_frame = tk.Frame(
    course_canvas,
    bg=BG
)

course_window = course_canvas.create_window(
    (0, 0),
    window=course_list_frame,
    anchor="nw"
)


def update_course_scroll(event=None):

    course_canvas.configure(
        scrollregion=course_canvas.bbox("all")
    )


def resize_course_frame(event):

    course_canvas.itemconfigure(
        course_window,
        width=event.width
    )


course_list_frame.bind(
    "<Configure>",
    update_course_scroll
)

course_canvas.bind(
    "<Configure>",
    resize_course_frame
)

course_canvas.configure(
    yscrollcommand=course_scrollbar.set
)

course_canvas.grid(
    row=0,
    column=0,
    sticky="nsew"
)

course_scrollbar.grid(
    row=0,
    column=1,
    sticky="ns"
)


def mousewheel(event):

    course_canvas.yview_scroll(
        int(-1 * (event.delta / 120)),
        "units"
    )


course_canvas.bind(
    "<MouseWheel>",
    mousewheel
)

#start

show_welcome()

name_entry.focus()

root.mainloop()
