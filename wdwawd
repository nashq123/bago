        for child in [
            code_label,
            name_label,
            tuition_label,
            view_label
        ]:
            child.config(
                bg=WHITE
            )

    for widget in children:

        widget.bind(
            "<Button-1>",
            open_course
        )

        widget.bind(
            "<Enter>",
            hover_on
        )

        widget.bind(
            "<Leave>",
            hover_off
        )

    return card


