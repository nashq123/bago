    def normalize_course_code(value):
        return re.sub(r"[^A-Z0-9]", "", (value or "").upper())

    canonical_codes = {}
    for code, name, skills, features in courses_data:
        canonical_codes[normalize_course_code(code)] = code

    cur.execute("SELECT id, course_code FROM courses ORDER BY id")
    existing_rows = cur.fetchall()
    seen_codes = set()

    for row_id, stored_code in existing_rows:
        normalized_code = normalize_course_code(stored_code)
        if normalized_code not in canonical_codes:
            cur.execute("DELETE FROM courses WHERE id = ?", (row_id,))
            continue
        if normalized_code in seen_codes:
            cur.execute("DELETE FROM courses WHERE id = ?", (row_id,))
            continue

        seen_codes.add(normalized_code)
        canonical_code = canonical_codes[normalized_code]

        
        if stored_code != canonical_code:
            cur.execute(
                "UPDATE courses SET course_code = ? WHERE id = ?",
                (canonical_code, row_id)
            )

    for code, name, skills, features in courses_data:

        cur.execute("""
            SELECT id
            FROM courses
            WHERE course_code = ?
        """, (code,))

        existing = cur.fetchone()

        if existing is None:

            cur.execute("""
                INSERT INTO courses
                (
                    course_code,
                    course_name,
                    skills,
                    features
                )
                VALUES (?, ?, ?, ?)
            """, (
                code,
                name,
                skills,
                features
            ))

        else:

            cur.execute("""
                UPDATE courses
                SET
                    course_name = CASE
                        WHEN course_name IS NULL
                             OR TRIM(course_name) = ''
                        THEN ?
                        ELSE course_name
                    END,
                    skills = CASE
                        WHEN skills IS NULL
                             OR TRIM(skills) = ''
                        THEN ?
                        ELSE skills
                    END,
                    features = CASE
                        WHEN features IS NULL
                             OR TRIM(features) = ''
                        THEN ?
                        ELSE features
                    END
                WHERE course_code = ?
            """, (
                name,
                skills,
                features,
                code
            ))

    conn.commit()
    conn.close()


