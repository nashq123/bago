# text na normal lang
def normalize_text(text):

    text = text.lower()

    text = text.replace(
        "–",
        " "
    )

    text = re.sub(
        r"[^a-z0-9áéíóúñü\s-]",
        " ",
        text
    )

    return text


def get_keywords(text):

    normalized = normalize_text(text)

    words = normalized.split()

    stopwords = {
        "the",
        "and",
        "or",
        "a",
        "an",
        "i",
        "am",
        "my",
        "is",
        "are",
        "to",
        "of",
        "in",
        "with",
        "for",
        "na",
        "ng",
        "ang",
        "ako",
        "gusto",
        "mahilig",
        "mahiligako",
        "may",
        "at"
    }

    return [
        word
        for word in words
        if len(word) >= 3
        and word not in stopwords
    ]


# recommend courses

def suggest_course():

    characteristics = (
        characteristics_entry.get()
        .strip()
    )

    skills = (
        skills_entry.get()
        .strip()
    )

    interests = (
        interests_entry.get()
        .strip()
    )

    combined = " ".join([
        characteristics,
        skills,
        interests
    ]).strip()

    if not combined:

        messagebox.showwarning(
            "Missing Information",
            "Please enter your characteristics, skills, or interests."
        )

        return

    keywords = get_keywords(
        combined
    )

    if not keywords:

        messagebox.showwarning(
            "Invalid Input",
            "Please enter meaningful characteristics, skills, or interests."
        )

        return

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        SELECT course_code, course_name, skills, features
        FROM courses
        ORDER BY id
    """)

    courses = cur.fetchall()

    conn.close()

    results = []

    for code, name, course_skills, features in courses:

        searchable = normalize_text(
            code + " " +
            name + " " +
            course_skills + " " +
            features
        )

        course_words = set(
            get_keywords(searchable)
        )

        score = 0
        matched_words = []

        for keyword in keywords:

            if keyword in course_words:

                score += 2
                matched_words.append(keyword)

            elif keyword in searchable:

                score += 1
                matched_words.append(keyword)

        if score > 0:

            results.append(
                (
                    score,
                    len(matched_words),
                    code,
                    name,
                    features
                )
            )

    results.sort(
        key=lambda x: (
            x[0],
            x[1]
        ),
        reverse=True
    )

    result_courses = []

    for score, matched, code, name, features in results:

        result_courses.append(
            (
                code,
                name,
                features
            )
        )

    display_courses(
        result_courses,
        f"RECOMMENDED PROGRAMS  •  {len(result_courses)} MATCHES"
    )


