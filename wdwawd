# dito yung calculator ng discount sa course

def calculate_scholarship_amount(tuition_text, rate):

    clean_text = (
        tuition_text
        .replace("₱", "")
        .replace(",", "")
    )

    if "–" in clean_text:

        parts = clean_text.split("–")

        try:

            low = float(parts[0].strip())

            high_text = parts[1].strip()

            high = float(
                high_text.split()[0]
            )

            discount_low = low * rate
            discount_high = high * rate

            payment_low = low - discount_low
            payment_high = high - discount_high

            return {
                "original": f"₱{low:,.0f} – ₱{high:,.0f}",
                "discount": f"₱{discount_low:,.0f} – ₱{discount_high:,.0f}",
                "payment": f"₱{payment_low:,.0f} – ₱{payment_high:,.0f}"
            }

        except ValueError:

            return None

    try:

        tuition = float(
            clean_text.split()[0]
        )

        discount = tuition * rate
        payment = tuition - discount

        return {
            "original": f"₱{tuition:,.0f}",
            "discount": f"₱{discount:,.0f}",
            "payment": f"₱{payment:,.0f}"
        }

    except (ValueError, IndexError):

        return None


