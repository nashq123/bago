def suggest_course():
    name = entry_name.get().strip()
    skills_input = entry_skills.get().lower().strip()

    # baba lang to ng result
    result_frame.pack(fill="x", pady=(20,0), anchor="center")

    if not skills_input or "ex:" in skills_input:
        result_label.config(text="Please fill up", fg="#E74C3C")
        return

    conn = get_connection()
    cur = conn.cursor()
    cur.execute("SELECT * FROM courses")
    all_courses = cur.fetchall()
    conn.close()

    user_skills = [k.strip() for k in skills_input.replace(',', '|').split('|') if len(k.strip()) >= 3]
    matched = []
    for course in all_courses:
        course_code, course_name, course_skills_str = course[1], course[2], course[3].lower()
        course_keywords = [k.strip() for k in course_skills_str.split(",")]
        score = 0
        found = []
        for u in user_skills:
            for c in course_keywords:
                if u == c or u in c.split() or c in u.split():
                    score += 1
                    if u not in found: found.append(u)
                    break
        if score > 0:
            matched.append((course_code, course_name, score, found))

    if not matched:
        result_label.config(text=f"Hi {name}, No match", fg="#E74C3C")
        reason_label.config(text="Try: coding, cooking, business", fg="#7f8c8d")
    else:
        matched_sorted = sorted(matched, key=lambda x: x[2], reverse=True)
        best = [f"{m[0]} - {m[1]}" for m in matched_sorted[:3]]
        top = matched_sorted[0]
        result_label.config(text=f"Hi {name}! Here is the suggested course: \n" + "\n".join(best), fg="#FB0808")

